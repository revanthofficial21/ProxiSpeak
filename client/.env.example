# Copy this file to client/.env and fill in the values.

# Where the Socket.IO server runs.
VITE_SERVER_URL=http://localhost:3000

# Optional TURN relay. STUN alone is enough on a LAN or with friendly NATs, but
# peers behind symmetric NATs or strict firewalls need a relay — without one the
# connection simply never establishes, with no visible error.
# Leave blank if you don't have one.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
