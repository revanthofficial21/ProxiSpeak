# Copy this file to server/.env and fill in the values.

# Required — MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://localhost:27017/proxispeak

# Port the server listens on.
PORT=3000

# Comma-separated list of browser origins allowed to connect.
# Leave unset (or "*") locally; set it explicitly in production.
CORS_ORIGIN=http://localhost:5173

# Optional: enables the multi-instance mesh. Without it the server runs as a
# single instance, which is fine for a team. With it, several instances share
# rooms and events through Redis, so 50+ concurrent users can be spread across
# processes.
# REDIS_URL=redis://localhost:6379
